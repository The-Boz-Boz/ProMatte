// Full-resolution matte refinement.
//
//  Upsample3 / Upsample5 : joint bilateral upsampling of the low-resolution
//                          matte guided by the full-resolution image. Produces
//                          crisp, edge-aligned alpha without the blockiness of
//                          plain bilinear upscaling. Output: r = refined alpha,
//                          g = bilinear alpha (for the confidence debug view).
//  EdgeTemporal          : temporal smoothing of the upsampled alpha inside the
//                          edge band, against the previous output (history).
//                          Output: r = alpha, g = bilinear alpha (passed
//                          through), b = source luma (next frame's history).
//  FeatherH / FeatherV   : separable Gaussian feathering of the alpha plane.
uniform float4x4 ViewProj;
uniform texture2d image;      // full-resolution source (guide)
uniform texture2d matte;      // low-resolution guide: rgb = downscaled colour, a = alpha
uniform texture2d guideLow;   // low-resolution colour (only used by the Merge pass)
uniform float2 lowSize;       // matte texture size in pixels
uniform float2 lowTexel;      // 1 / lowSize
uniform float2 guideTexel;    // 1 / full-resolution size (image)
uniform float  rangeSigma;    // colour similarity sigma (0.05..0.3)
uniform float2 texel;         // 1 / output size (feather)
uniform float  radius;        // feather radius in output pixels
uniform float2 direction;     // (1,0) or (0,1)
uniform texture2d history;    // EdgeTemporal: previous output (r alpha, b luma)
uniform texture2d sourceTex;  // EdgeTemporal: full-resolution source
uniform float  edgeK;         // EdgeTemporal: blend factor inside the band (1 = off)
uniform float  historyValid;  // EdgeTemporal: 0 = no usable history, pass through
uniform float  newMatte;      // EdgeTemporal: 1 when a new matte arrived this frame

sampler_state linearSampler {
	Filter    = Linear;
	AddressU  = Clamp;
	AddressV  = Clamp;
};
sampler_state pointSampler {
	Filter    = Point;
	AddressU  = Clamp;
	AddressV  = Clamp;
};

struct VertData {
	float4 pos : POSITION;
	float2 uv  : TEXCOORD0;
};

VertData VSDefault(VertData v_in)
{
	VertData vert_out;
	vert_out.pos = mul(float4(v_in.pos.xyz, 1.0), ViewProj);
	vert_out.uv  = v_in.uv;
	return vert_out;
}

float colourDistance(float3 a, float3 b)
{
	float3 d = abs(a - b);
	// luma-weighted L1 distance
	return d.r * 0.4 + d.g * 0.45 + d.b * 0.15;
}

// Guide colour averaged over the pixel's neighbourhood: four bilinear taps at
// half-texel offsets each average a 2x2 block, together a 3x3 tent centred on
// the pixel (no half-pixel shift). Sensor noise in the guide drives the range
// weights, so a single-pixel guide makes the edge flicker from frame to frame;
// the tent cuts the noise variance to ~0.14 of a single pixel's. The
// low-resolution guide is an area average anyway, so this also matches it better.
float3 guideColour(float2 uv)
{
	float2 h = guideTexel * 0.5;
	float3 c = image.Sample(linearSampler, uv + float2(-h.x, -h.y)).rgb;
	c += image.Sample(linearSampler, uv + float2( h.x, -h.y)).rgb;
	c += image.Sample(linearSampler, uv + float2(-h.x,  h.y)).rgb;
	c += image.Sample(linearSampler, uv + float2( h.x,  h.y)).rgb;
	return c * 0.25;
}

// One sample per neighbour: the low-resolution texture carries the guide colour
// in rgb and the matte in a, so colour similarity and alpha come from the same fetch.
float4 jbu(float2 uv, int r)
{
	float3 guide = guideColour(uv);
	float2 lowPos = uv * lowSize - 0.5;
	float2 base = floor(lowPos);
	float invRange = 1.0 / max(rangeSigma, 0.01);
	float sumW = 0.0;
	float sumA = 0.0;
	for (int dy = -r + 1; dy <= r; ++dy) {
		for (int dx = -r + 1; dx <= r; ++dx) {
			float2 q = base + float2(dx, dy);
			float4 low = matte.Sample(pointSampler, (q + 0.5) * lowTexel);
			float2 d = lowPos - q;
			float spatial = exp(-dot(d, d) * 0.5);
			float cd = colourDistance(guide, low.rgb) * invRange;
			float range = exp(-cd * cd * 0.5);
			float w = spatial * range + 1e-5;
			sumW += w;
			sumA += w * low.a;
		}
	}
	float bilinear = matte.Sample(linearSampler, uv).a;
	float a = sumW > 1e-3 ? sumA / sumW : bilinear;
	return float4(a, bilinear, 0.0, 1.0);
}

// Packs the AI-resolution colour (rgb) and the model matte (a) into one texture.
float4 PSMerge(VertData v_in) : TARGET
{
	float3 colour = guideLow.Sample(pointSampler, v_in.uv).rgb;
	float alpha = matte.Sample(pointSampler, v_in.uv).a;
	return float4(colour, alpha);
}

float4 PSUpsample3(VertData v_in) : TARGET
{
	return jbu(v_in.uv, 1); // 2x2 neighbourhood weighted (fast)
}

float4 PSUpsample5(VertData v_in) : TARGET
{
	return jbu(v_in.uv, 2); // 4x4 neighbourhood weighted
}

float lumaOf(float3 c)
{
	return dot(c, float3(0.299, 0.587, 0.114));
}

// 1 inside the semi-transparent edge band, 0 for solid foreground/background.
float edgeBand(float a)
{
	return smoothstep(0.02, 0.05, a) * (1.0 - smoothstep(0.95, 0.98, a));
}

// Largest change of the 2x2-averaged source luma around the pixel (four
// bilinear taps, a 3x3 footprint) against the luma stored in the history.
float lumaChange(float2 uv)
{
	float2 h = guideTexel * 0.5;
	float2 o0 = float2(-h.x, -h.y);
	float2 o1 = float2( h.x, -h.y);
	float2 o2 = float2(-h.x,  h.y);
	float2 o3 = float2( h.x,  h.y);
	float d = abs(lumaOf(sourceTex.Sample(linearSampler, uv + o0).rgb) - history.Sample(linearSampler, uv + o0).b);
	d = max(d, abs(lumaOf(sourceTex.Sample(linearSampler, uv + o1).rgb) - history.Sample(linearSampler, uv + o1).b));
	d = max(d, abs(lumaOf(sourceTex.Sample(linearSampler, uv + o2).rgb) - history.Sample(linearSampler, uv + o2).b));
	d = max(d, abs(lumaOf(sourceTex.Sample(linearSampler, uv + o3).rgb) - history.Sample(linearSampler, uv + o3).b));
	return d;
}

float4 PSEdgeTemporal(VertData v_in) : TARGET
{
	float2 uv = v_in.uv;
	float4 cur = image.Sample(pointSampler, uv);
	float lumaHere = lumaOf(sourceTex.Sample(pointSampler, uv).rgb);
	if (historyValid < 0.5)
		return float4(cur.r, cur.g, lumaHere, 1.0);
	float4 prev = history.Sample(pointSampler, uv);
	float d = lumaChange(uv);
	// Blend only in the edge band (of either frame, so a strand that flickers
	// out is caught too) and only where the image did not change: any real
	// motion (|delta luma| over the 3x3 above the noise) passes straight through.
	float band = max(edgeBand(cur.r), edgeBand(prev.r));
	float motion = smoothstep(0.025, 0.06, d);
	float k = lerp(1.0, edgeK, band * (1.0 - motion));
	// OBS renders more frames than a 20-30 fps camera delivers. With no new
	// matte and an unchanged source pixel (a repeated frame; the stored luma is
	// 8-bit, hence the small tolerance) the history is held, so repeats do not
	// count as extra blending steps.
	if (newMatte < 0.5 && d < 0.004)
		k = 0.0;
	float a = lerp(prev.r, cur.r, k);
	return float4(a, cur.g, lumaHere, 1.0);
}

float4 PSFeather(VertData v_in) : TARGET
{
	// 9-tap Gaussian (sigma = radius / 2) sampled at multiples of radius / 4.
	float step = max(radius, 0.001) * 0.25;
	float2 d = direction * texel * step;
	float w0 = 0.2270270270, w1 = 0.1945945946, w2 = 0.1216216216, w3 = 0.0540540541, w4 = 0.0162162162;
	float a = image.Sample(linearSampler, v_in.uv).r * w0;
	a += image.Sample(linearSampler, v_in.uv + d * 1.0).r * w1;
	a += image.Sample(linearSampler, v_in.uv - d * 1.0).r * w1;
	a += image.Sample(linearSampler, v_in.uv + d * 2.0).r * w2;
	a += image.Sample(linearSampler, v_in.uv - d * 2.0).r * w2;
	a += image.Sample(linearSampler, v_in.uv + d * 3.0).r * w3;
	a += image.Sample(linearSampler, v_in.uv - d * 3.0).r * w3;
	a += image.Sample(linearSampler, v_in.uv + d * 4.0).r * w4;
	a += image.Sample(linearSampler, v_in.uv - d * 4.0).r * w4;
	float g = image.Sample(linearSampler, v_in.uv).g;
	return float4(a, g, 0.0, 1.0);
}

technique Merge
{
	pass
	{
		vertex_shader = VSDefault(v_in);
		pixel_shader  = PSMerge(v_in);
	}
}

technique Upsample3
{
	pass
	{
		vertex_shader = VSDefault(v_in);
		pixel_shader  = PSUpsample3(v_in);
	}
}

technique Upsample5
{
	pass
	{
		vertex_shader = VSDefault(v_in);
		pixel_shader  = PSUpsample5(v_in);
	}
}

technique EdgeTemporal
{
	pass
	{
		vertex_shader = VSDefault(v_in);
		pixel_shader  = PSEdgeTemporal(v_in);
	}
}

technique Feather
{
	pass
	{
		vertex_shader = VSDefault(v_in);
		pixel_shader  = PSFeather(v_in);
	}
}
